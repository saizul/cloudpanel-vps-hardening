# Copy to config.env and edit. Passed with --config, or auto-loaded from ./config.env.
# All values are optional; defaults shown.

# ---- harden.sh -------------------------------------------------------------
ADMIN_USER=""                  # sudo user to create (empty = skip)
ADMIN_SSH_PUBKEY=""            # e.g. "ssh-ed25519 AAAA... you@laptop" (required to create user)
SSH_PORT=22                    # change only if you also open it in your cloud firewall
SSH_ALLOW_USERS=""             # space separated; empty = do not set AllowUsers
UFW_PANEL_PORT=""              # e.g. 8443 for CloudPanel; empty = do not open
UFW_PANEL_ALLOW=""             # space separated IPs/CIDRs allowed to the panel port, e.g. "203.0.113.10 198.51.100.0/24"
                               # if UFW_PANEL_PORT is set and this is empty, the port is opened to everyone (warned)
F2B_MAXRETRY=5
F2B_FINDTIME=10m
F2B_BANTIME=1h
SWAP_SIZE=2G                   # created only if no swap exists
TIMEZONE="UTC"

# ---- backup.sh -------------------------------------------------------------
BACKUP_DIR=/var/backups/vps
BACKUP_RETENTION_DAYS=14
SITES_DIR=/home                # each immediate subdirectory is tarred separately
DB_EXCLUDE="information_schema performance_schema sys mysql"
RCLONE_REMOTE=""               # e.g. "b2:my-bucket/vps"; empty = no offsite copy
# MySQL/MariaDB credentials: use /root/.my.cnf (chmod 600) with a [client] section.

# ---- redis-setup.sh --------------------------------------------------------
REDIS_MAXMEMORY=256mb
REDIS_POLICY=allkeys-lru
REDIS_PASSWORD=""              # empty = no requirepass (still bound to localhost only)
